# Kopiere diese Datei zu ".env.deploy" und trag deine echten all-inkl-FTP-Zugangsdaten ein.
# .env.deploy ist in .gitignore und wird nie committet.
#
# Zu finden in KAS (all-inkl Kundenverwaltung) unter "FTP-Konten":
#   ALLINKL_FTP_HOST     -> Serveradresse, meist "ftp.deine-domain.de" oder ein Server wie "wxyz.kasserver.com"
#   ALLINKL_FTP_PORT     -> Port (bei all-inkl meist 21) -- leer lassen, wenn nicht angegeben
#   ALLINKL_FTP_USER     -> Benutzername
#   ALLINKL_FTP_PASSWORD -> Passwort
#   ALLINKL_FTP_REMOTE_DIR -> Zielordner auf dem Server, z.B. "/" fuer den Hauptordner
#                             der Domain, oder "/nw-tennis" fuer eine Unterdomain/Unterordner.
#                             ACHTUNG: Der Inhalt dieses Ordners wird bei jedem Deploy
#                             komplett geleert und durch den neuen Build ersetzt!

ALLINKL_FTP_HOST=
ALLINKL_FTP_PORT=
ALLINKL_FTP_USER=
ALLINKL_FTP_PASSWORD=
ALLINKL_FTP_REMOTE_DIR=/
ALLINKL_FTP_SECURE=true

# Passwort des Postfachs support@dolphintennis.com (KAS -> "E-Mail" -> "E-Mail Postfach").
# Supabase verschickt damit die Anmelde-/Bestaetigungsmails ueber all-inkl statt
# ueber den Supabase-Absender. Wird von "supabase config push" gelesen -- siehe
# den [auth.email.smtp]-Block in supabase/config.toml.
SMTP_PASSWORD=
