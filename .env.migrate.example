# Vorlage für den Umzug in ein neues Supabase-Konto. Echte Werte gehören in
# .env.migrate — die Datei ist gitignored und darf nie eingecheckt werden.
# Beide Skripte werden mit `node --env-file=.env.migrate …` aufgerufen.
#
# Nach dem Umzug ersatzlos löschen: der service_role-Schlüssel umgeht jede
# Zugriffsregel, und das Datenbank-Passwort steht hier im Klartext.

# --- Datenbankverbindungen (scripts/migrate-data.mjs) ---------------------
# Dashboard → Project Settings → Database → Connection string → URI.
# Den Session-Pooler nehmen (Port 5432), nicht den Transaction-Pooler (6543):
# der Transaction-Pooler kann keine mehrteiligen Anweisungen.
# Sonderzeichen im Passwort müssen prozentkodiert sein (@ → %40).
SOURCE_DB_URL=postgresql://postgres.lguvrhdvlqipbjkesuon:PASSWORT@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
TARGET_DB_URL=postgresql://postgres.ayfiezwtgazcvkepefwv:PASSWORT@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Storage (scripts/migrate-storage.mjs) -------------------------------
# Dashboard → Project Settings → API. Der service_role-Schlüssel, nicht der
# anon-Schlüssel — die Storage-Regeln lassen sonst nichts durch.
SOURCE_SUPABASE_URL=https://lguvrhdvlqipbjkesuon.supabase.co
SOURCE_SERVICE_ROLE_KEY=
TARGET_SUPABASE_URL=https://ayfiezwtgazcvkepefwv.supabase.co
TARGET_SERVICE_ROLE_KEY=
